DATABASE_URL=sqlserver://localhost:1433;database=dashboard;integratedSecurity=true;trustServerCertificate=true;encrypt=true
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_OPERATOR_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_VIEWER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Optional override for .bak output (defaults to ./sql-backups). Must be absolute, writable by SQL Server, and readable by Next.js.
# SQLSERVER_BACKUP_DIR=C:\\SqlBackups
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.103:3000
